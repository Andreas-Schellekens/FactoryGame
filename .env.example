# Copy to .env (never committed) to record DELTA's voice: npm run voice
ELEVENLABS_API_KEY=
# The voice made in ElevenLabs Voice Design
DELTA_VOICE_ID=
# Optional: a cheerful corporate announcer for NILE broadcasts
NILE_VOICE_ID=
# Optional: NIHIL's boss, Nolan Isaac Locke (planned, not recorded yet)
NIHIL_BOSS_VOICE_ID=
# Optional: VASSAL, the machine assistant after the hidden Overload ending (a robotic voice; its lines stay text-only without it)
VASSAL_VOICE_ID=
# Optional, default eleven_multilingual_v2
ELEVENLABS_MODEL=

# ---- The API (api/, Rust) for accounts, cloud saves and the leaderboard: npm run dev:api
# A local PostgreSQL database (create it first, e.g. "createdb selene_dev").
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/selene_dev
# Listen here; Vite (npm run dev) forwards /api to it.
HOST=127.0.0.1
PORT=8787
# 1 in production (HTTPS): the session cookie is only sent over HTTPS.
COOKIE_SECURE=0
# 1 in local development: rate limits ×100 (the browser tests sign up a lot). Never on Railway.
RELAX_LIMITS=1
